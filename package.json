{
  "name": "world-of-sofia",
  "private": true,
  "version": "0.1.0",
  "description": "Codex skill collection and toolkit for philosopher-derived software work habits.",
  "scripts": {
    "lint": "eslint scripts skills",
    "validate:skills": "node ./scripts/validate-skills.mjs",
    "validate:skill-traces": "node ./scripts/validate-skill-traces.mjs",
    "check:isolation": "node ./scripts/check-isolation.mjs",
    "check": "npm run lint && npm run validate:skills && npm run validate:skill-traces && npm run check:isolation && npm run test",
    "test:pattern-code-wittgenstein": "vitest run skills/pattern-code-wittgenstein/tests/pattern-scout.test.mjs",
    "test": "vitest run scripts/lib/skills.test.mjs && npm run test:pattern-code-wittgenstein",
    "new:skill": "node ./scripts/new-skill.mjs",
    "install:skills": "node ./scripts/sync-codex-skills.mjs",
    "install:skill": "node ./scripts/sync-codex-skills.mjs --skill",
    "sync:skills": "node ./scripts/sync-codex-skills.mjs",
    "sync:skill": "node ./scripts/sync-codex-skills.mjs --skill"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.42.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
