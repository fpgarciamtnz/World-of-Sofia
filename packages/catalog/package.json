{
  "name": "@world-of-sofia/catalog",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/generate-catalog.mjs && tsc -p tsconfig.build.json",
    "lint": "eslint src scripts test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:skills": "node ./scripts/validate-skills.mjs",
    "check:isolation": "node ./scripts/check-isolation.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.12"
  }
}

